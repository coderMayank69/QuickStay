

/.ai
# Dependencies
node_modules/
.pnp

# LLM Project Context (keep local only — too large for repo)
AI_CONTEXT.md
.pnp.js

# .env.production is committed intentionally — VITE_ vars are PUBLIC (baked into JS bundle)
# Real secrets live server-side in AWS SSM, never here

# All other .env files have real secrets — never commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
server/.env.*
# Allow client/.env.production (only public VITE_ vars, safe for Vercel build)
!client/.env.production

# Build output
dist/
dev-dist/
build/
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# AI / dev context
.ai-context.md

